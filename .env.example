# Public values by design (they end up in the bundle). Never put the service_role key here.
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key

# Optional, only for `npm run verify:rls` signed-in checks (see scripts/README.md). Throw-away users, never your own account.
# RLS_TEST_EMAIL=
# RLS_TEST_PASSWORD=
# RLS_TEST_MFA_EMAIL=
# RLS_TEST_MFA_PASSWORD=

# Optional, three-user checks of the coach/athlete tables (see scripts/README.md). Throw-away users, never your own account.
# None of the three has a second factor: the athlete creates the link (active at once) and the coach reads with a password session.
# RLS_TEST_COACH_EMAIL=
# RLS_TEST_COACH_PASSWORD=
# RLS_TEST_ATHLETE_EMAIL=
# RLS_TEST_ATHLETE_PASSWORD=
# RLS_TEST_STRANGER_EMAIL=
# RLS_TEST_STRANGER_PASSWORD=
# A user who is athlete and coach at once, without a factor (optional):
# RLS_TEST_BOTH_EMAIL=
# RLS_TEST_BOTH_PASSWORD=
# A coach WITH a verified TOTP factor, whose base32 secret lets the script reach aal2 (optional; it still needs aal2 to read):
# RLS_TEST_COACH_MFA_EMAIL=
# RLS_TEST_COACH_MFA_PASSWORD=
# RLS_TEST_COACH_MFA_TOTP_SECRET=
